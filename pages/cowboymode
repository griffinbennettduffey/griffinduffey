<title>Cody × Yellowstone — Aug 2026</title>
<style>
  :root{
    --ink:#17170f; --band:#1c1b16; --paper:#f2f1ea; --card:#fbfaf5;
    --pine:#4f5d42; --pine-deep:#3a4530; --thermal:#c05a1f; --lake:#5f8393;
    --rule:#d8d5c8; --mute:#6f6d60; --done:#a8a494;
  }
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  body{
    font-family:"Times New Roman",Times,"Liberation Serif",Georgia,serif;
    background:var(--paper);color:var(--ink);padding-bottom:2.5rem;
  }
  header{
    background:var(--band);color:#f4f2ea;
    padding:calc(env(safe-area-inset-top,0px) + 1.1rem) 1.1rem 1rem;
  }
  .eyebrow{font-size:.66rem;letter-spacing:.22em;text-transform:uppercase;color:#b9b5a6;margin-bottom:.35rem}
  h1{font-size:1.5rem;font-weight:800;letter-spacing:-.01em;line-height:1.1}
  h1 .x{color:var(--thermal);font-weight:400;padding:0 .1em}
  .hdr-sub{font-size:.8rem;color:#b9b5a6;margin-top:.4rem;line-height:1.5}
  nav{
    position:sticky;top:0;z-index:10;background:var(--band);
    display:flex;overflow-x:auto;scrollbar-width:none;
    border-bottom:4px solid var(--thermal);
  }
  nav::-webkit-scrollbar{display:none}
  nav a{
    flex:0 0 auto;padding:.7rem .85rem .6rem;color:#b9b5a6;text-decoration:none;
    font-size:.74rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
    text-align:center;line-height:1.25;
  }
  nav a small{display:block;font-size:.62rem;font-weight:500;text-transform:none;opacity:.8}
  main{max-width:640px;margin:0 auto;padding:1rem .9rem 0}
  section{scroll-margin-top:3.4rem;margin-bottom:2rem}
  .dayhead{margin:.2rem 0 1rem;border-left:4px solid var(--pine);padding-left:.8rem}
  .dayhead h2{font-size:1.2rem;font-weight:800}
  .dayhead .meta{font-size:.8rem;color:var(--mute);margin-top:.3rem;line-height:1.6}
  .meta b{color:var(--pine-deep);font-weight:700}
  .shiftrow{display:none;gap:.35rem;flex-wrap:wrap;margin-top:.6rem}
  .js .shiftrow{display:flex}
  .sh{
    font:inherit;font-size:.72rem;font-weight:700;padding:.3rem .65rem;
    border:1px solid var(--rule);border-radius:.9rem;background:var(--card);
    color:var(--mute);cursor:pointer;text-align:center;line-height:1.3;
  }
  .sh span{display:block;font-weight:500;font-size:.64rem}
  .sh.active{background:var(--pine);border-color:var(--pine);color:#fff}
  .shnote{display:none;font-size:.7rem;color:var(--mute);margin-top:.35rem;font-style:italic}
  .js .shnote{display:block}
  /* ---- stop cards ---- */
  .stop{
    position:relative;background:var(--card);border:1px solid var(--rule);
    border-radius:.5rem;margin-bottom:.65rem;
  }
  .ck{position:absolute;opacity:0;pointer-events:none}
  .check{
    position:absolute;top:.7rem;right:.7rem;width:1.5rem;height:1.5rem;
    border:2px solid var(--rule);border-radius:.35rem;background:var(--card);
    display:flex;align-items:center;justify-content:center;
    font-size:.9rem;color:transparent;cursor:pointer;z-index:2;
    font-family:-apple-system,Helvetica,sans-serif;
  }
  .ck:checked + .check{background:var(--pine);border-color:var(--pine);color:#fff}
  .ck:checked ~ details summary .title,
  .ck:checked ~ details summary .time b{color:var(--done);text-decoration:line-through;text-decoration-thickness:1px}
  details summary{
    list-style:none;display:flex;align-items:flex-start;gap:.75rem;
    padding:.75rem 2.7rem .75rem .8rem;cursor:pointer;
  }
  details summary::-webkit-details-marker{display:none}
  .time{flex:0 0 4.1rem;padding-top:.1rem;font-variant-numeric:tabular-nums}
  .time b{font-size:.82rem;font-weight:800;color:var(--pine-deep);letter-spacing:.02em}
  .time small{font-weight:500;color:var(--mute);font-size:.62rem;margin-left:.1rem}
  .time em{display:block;font-style:normal;font-weight:600;font-size:.72rem;color:var(--mute);margin-top:.1rem}
  .tl{display:inline-block;font-size:.5rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--thermal);margin-right:.18rem;font-family:-apple-system,Helvetica,sans-serif}
  .time em .tl{color:var(--mute)}
  .stop-main{flex:1;min-width:0}
  .title{font-size:1rem;font-weight:700;line-height:1.3}
  .chips{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:.4rem}
  .chip{
    font-size:.68rem;font-weight:600;padding:.18rem .5rem;border-radius:.9rem;
    border:1px solid var(--rule);color:var(--mute);background:var(--paper);
    font-family:-apple-system,Helvetica,sans-serif;font-size:.62rem;
  }
  .chip.drive{border-color:#c9d2d8;color:var(--lake);background:#eef2f4}
  .body{padding:0 .8rem .85rem 5.65rem;font-size:.88rem;line-height:1.6;color:#3c3a30}
  .body p{margin-bottom:.5rem}
  .lookfor{
    border-left:3px solid var(--pine);background:#f0f1e9;
    padding:.5rem .65rem;border-radius:0 .35rem .35rem 0;margin:.4rem 0 .55rem;
  }
  .lookfor b{
    font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;color:var(--pine-deep);
    display:block;margin-bottom:.2rem;font-family:-apple-system,Helvetica,sans-serif;
  }
  .maplink{
    display:inline-block;margin-top:.15rem;font-size:.78rem;font-weight:700;color:var(--lake);
    text-decoration:none;border-bottom:1.5px solid #c4d0d7;
  }
  /* ---- info ---- */
  .infoblock{
    background:var(--card);border:1px solid var(--rule);border-radius:.5rem;
    padding:.9rem .95rem;margin-bottom:.75rem;font-size:.88rem;line-height:1.6;
  }
  .infoblock h3{
    font-size:.66rem;letter-spacing:.18em;text-transform:uppercase;color:var(--pine-deep);
    margin-bottom:.5rem;font-weight:800;font-family:-apple-system,Helvetica,sans-serif;
  }
  .infoblock .big{font-size:1.1rem;font-weight:800;font-variant-numeric:tabular-nums}
  .infoblock ul{list-style:none}
  .infoblock li{padding:.22rem 0 .22rem 1.05rem;position:relative}
  .infoblock li::before{content:"▸";position:absolute;left:0;color:var(--thermal);font-size:.75rem;top:.3rem}
  .kv{display:flex;justify-content:space-between;gap:1rem;padding:.28rem 0;border-bottom:1px dashed var(--rule)}
  .kv:last-child{border-bottom:0}
  .kv span:first-child{color:var(--mute);font-size:.78rem}
  .kv span:last-child{font-weight:700;text-align:right}
  footer{text-align:center;font-size:.66rem;color:var(--mute);letter-spacing:.14em;text-transform:uppercase;padding:1.2rem 0 .5rem}

  .kit{background:#eef0e7;border:1px dashed var(--pine);border-radius:.5rem;
    padding:.6rem .8rem;margin:0 0 .8rem;font-size:.8rem;line-height:1.75;color:#3c3a30}
  .kit b{display:block;font-size:.6rem;letter-spacing:.16em;text-transform:uppercase;
    color:var(--pine-deep);margin-bottom:.25rem;font-family:-apple-system,Helvetica,sans-serif}
  .chip.meal{background:var(--thermal);border-color:var(--thermal);color:#fff;
    font-weight:800;letter-spacing:.08em;text-transform:uppercase}

  .chip.swim{background:var(--lake);border-color:var(--lake);color:#fff;
    font-weight:800;letter-spacing:.08em;text-transform:uppercase}

  .legend{background:#26241d;color:#b9b5a6;font-size:.7rem;line-height:1.5;
    padding:.45rem 1.1rem .55rem;border-top:1px solid #3a382f}
  .legend b{color:#f4f2ea}
  .legend .arw{color:var(--thermal);font-weight:800}

  .flow{display:block;margin-top:.4rem;font-size:.68rem;line-height:1.5;color:var(--mute);
    font-family:-apple-system,Helvetica,sans-serif;letter-spacing:.01em}
  .flow em{font-style:normal;font-weight:700;color:var(--thermal)}

  .trail{border-left:3px solid var(--lake);background:#eaf0f2;
    padding:.5rem .65rem;border-radius:0 .35rem .35rem 0;margin:.4rem 0 .55rem}
  .trail b.h{font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;color:#3e5a66;
    display:block;margin-bottom:.2rem;font-family:-apple-system,Helvetica,sans-serif}
</style>
</head>
